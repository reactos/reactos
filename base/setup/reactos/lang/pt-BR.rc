/* Error Strings */

STRINGTABLE
BEGIN
    IDS_ERROR_INVALID_INSTALLDIR_CHAR_TITLE "Caractere inválido"
    IDS_ERROR_INVALID_INSTALLDIR_CHAR "Os únicos caracteres válidos são:\n\
alphanumericals (a-z, A-Z, 0-9), and\n . \\ - _\n\
Espaços não são permitidos."

    IDS_ERROR_DIRECTORY_NAME_TITLE "Caminho da instalação inválido."
    IDS_ERROR_DIRECTORY_NAME "O caminho da instalação do ReactOS deve seguir o esquema de nomes do DOS 8.3, \
e conter apenas letras, dígitos, travessões e pontos. Espaços não são permitidos."

    IDS_ERROR_CREATE_PARTITION_TITLE "Criar partição"
    IDS_ERROR_CREATE_PARTITION "Falha ao criar nova partição."

    IDS_WARN_DELETE_PARTITION_TITLE "Excluir partição?"
    IDS_WARN_DELETE_PARTITION "Tem certeza de que deseja apagar a partição selecionada?"
    IDS_WARN_DELETE_MBR_EXTENDED_PARTITION "Tem certeza de que deseja excluir a partição estendida selecionada e TODAS as partições lógicas que ela contém?"

    IDS_ERROR_WRITE_PTABLE "O instalador falhou ao escrever as tabelas de partição."

    IDS_ERROR_SYSTEM_PARTITION "O instalador do ReactOS não pôde encontrar uma partição de sistema suportada\n\
em seu sistema ou não pôde criar uma nova. Sem tal partição,\n\
o programa de instalação não pode instalar o ReactOS.\
\nClique em OK para voltar para a lista de seleção de partições."

    IDS_ERROR_FORMAT_UNRECOGNIZED_VOLUME "Disco não reconhecido durante a tentativa de formatar a partição."

    IDS_ERROR_COULD_NOT_FORMAT "O instalador não pode formatar a partição em %s no momento.\n\
\nClique em OK para continuar instalação.\
\nClique em CANCELAR para sair do instalador."

    IDS_ERROR_FORMATTING_PARTITION "Instalador não pôde formatar a partição:\n %s\n"

    IDS_ERROR_COULD_NOT_CHECK "O instalador não pode verificar uma partição formatada em %s no momento.\n\
\nClique em OK para continuar a instalação.\
\nClique em CANCELAR para sair do instalador."

    IDS_ERROR_CHECKING_PARTITION "ChkDsk detectou alguns erros no disco.\n(Status 0x%08lx)."

    IDS_ERROR_WRITE_BOOT "Instalador falhou em instalar o bootcode %s na partição do sistema."
    IDS_ERROR_INSTALL_BOOTCODE "Instalador falhou ao instalar o bootcode %s no disco de inicialização."
    IDS_ERROR_INSTALL_BOOTCODE_REMOVABLE "Instalador falhou ao instalar o bootcode na mídia removível."
    IDS_ERROR_BOOTLDR_ARCH_UNSUPPORTED "Instalador atualmente não suporta instalar o bootloader no computador que você está usando.\
\nClique em OK para continuar de qualquer forma."
    IDS_ERROR_BOOTLDR_FAILED "Instalador não pôde instalar o bootloader (Status 0x%08lx)."
END
