/* Error Strings */

STRINGTABLE
BEGIN
    IDS_ERROR_INVALID_INSTALLDIR_CHAR_TITLE "无效字符"
    IDS_ERROR_INVALID_INSTALLDIR_CHAR "只能使用以下字符：\n字母和数字 (a-z、A-Z、0-9)，以及\n . \\ - _\n不能包含空格。"

    IDS_ERROR_DIRECTORY_NAME_TITLE "无效的安装路径"
    IDS_ERROR_DIRECTORY_NAME "ReactOS 安装路径必须符合 DOS 8.3 命名规则，只能包含字母、数字、连字符和句点，不能包含空格。"

    IDS_ERROR_CREATE_PARTITION_TITLE "创建分区"
    IDS_ERROR_CREATE_PARTITION "无法创建新分区。"

    IDS_WARN_DELETE_PARTITION_TITLE "删除分区？"
    IDS_WARN_DELETE_PARTITION "确定要删除所选分区吗？"
    IDS_WARN_DELETE_MBR_EXTENDED_PARTITION "确定要删除所选扩展分区及其包含的所有逻辑分区吗？"

    IDS_ERROR_WRITE_PTABLE "安装程序无法写入分区表。"

    IDS_ERROR_SYSTEM_PARTITION "安装程序找不到受支持的系统分区，或无法创建新的系统分区。\n没有可用的系统分区，就无法安装 ReactOS。\n单击“确定”返回分区选择列表。"

    IDS_ERROR_FORMAT_UNRECOGNIZED_VOLUME "格式化分区时无法识别该卷。"

    IDS_ERROR_COULD_NOT_FORMAT "安装程序目前无法将分区格式化为 %s。\n\n单击“确定”继续安装。\n单击“取消”退出安装程序。"

    IDS_ERROR_FORMATTING_PARTITION "安装程序无法格式化分区：\n %s\n"

    IDS_ERROR_COULD_NOT_CHECK "安装程序目前无法检查使用 %s 文件系统的分区。\n\n单击“确定”继续安装。\n单击“取消”退出安装程序。"

    IDS_ERROR_CHECKING_PARTITION "ChkDsk 检测到磁盘错误。\n(状态码 0x%08lx)"

    IDS_ERROR_WRITE_BOOT "安装程序无法在系统分区上安装 %s 引导代码。"
    IDS_ERROR_INSTALL_BOOTCODE "安装程序无法在启动磁盘上安装 %s 引导代码。"
    IDS_ERROR_INSTALL_BOOTCODE_REMOVABLE "安装程序无法在可移动介质上安装引导代码。"
    IDS_ERROR_BOOTLDR_ARCH_UNSUPPORTED "安装程序目前不支持在此计算机上安装引导程序。\n单击“确定”仍然继续安装。"
    IDS_ERROR_BOOTLDR_FAILED "安装程序无法安装引导程序 (状态码 0x%08lx)。"
END
