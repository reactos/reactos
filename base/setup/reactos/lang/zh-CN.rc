STRINGTABLE
BEGIN
    IDS_FORMATTING_PROGRESS1 "正在格式化卷 %c: (%s)，文件系统为 %s..."
    IDS_FORMATTING_PROGRESS2 "正在格式化卷 %s，文件系统为 %s..."

    IDS_CHECKING_PROGRESS1 "正在检查卷 %c: (%s)..."
    IDS_CHECKING_PROGRESS2 "正在检查卷 %s..."

    IDS_COPYING  "正在复制 %s"
    IDS_MOVING   "正在将 %s 移动到 %s"
    IDS_RENAMING "正在将 %s 重命名为 %s"
    IDS_DELETING "正在删除 %s"

    IDS_CONFIG_SYSTEM_PARTITION "正在配置系统分区..."
    IDS_PREPARE_PARTITIONS "正在准备分区..."
    IDS_PREPARE_FILES "正在准备要复制的文件列表，请稍候..."
    IDS_COPYING_FILES "正在复制文件..."

    IDS_CREATE_REGISTRY "正在创建注册表..."
    IDS_UPDATE_REGISTRY "正在更新注册表..."

    // IDS_INSTALL_FINALIZE "Finalizing the installation..."
