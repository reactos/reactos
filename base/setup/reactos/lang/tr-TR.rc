LANGUAGE LANG_TURKISH, SUBLANG_DEFAULT

/* Dialogs */

IDD_STARTPAGE DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "ReactOS Kurulum Sihirbazı'na hoş geldiniz", IDC_STARTTITLE, 115, 8, 195, 24
    LTEXT "Bu sihirbaz bilgisayarınıza ReactOS'u kuracak veya yükseltecek \
ve kurulumun ikinci aşamasına hazırlayacaktır.", IDC_STATIC, 115, 40, 195, 27
////
    GROUPBOX " ÖNEMLİ BİLGİ ", IDC_WARNTEXT1, 115, 70, 195, 90, BS_CENTER
    LTEXT "ReactOS Alfa aşamasındadır: Özellikleri henüz tamamlanmamıştır ve \
yoğun geliştirme aşamasındadır. Günlük kullanım işletim sistemi olarak değil, yalnızca \
deneme ve test amacıyla kullanılması önerilir.\n\
Verilerinizi bozabilir veya donanımınıza zarar verebilir.", IDC_WARNTEXT2, 120, 80, 185, 50, SS_CENTER
    LTEXT "Eğer ReactOS'u gerçek bir donanımda çalıştırmayı deneyecekseniz, \
verilerinizi yedekleyin veya ikincil bir bilgisayarda test edin.", IDC_WARNTEXT3, 120, 130, 185, 27, SS_CENTER
////
    LTEXT "Kuruluma devam etmek için İleri'ye tıklayınız.", IDC_STATIC, 115, 169, 195, 17
END

IDD_TYPEPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "ReactOS'u &Yükleme", IDC_INSTALL, 7, 20, 277, 10, WS_GROUP
    AUTORADIOBUTTON "ReactOS'u &Onarma ya da Yükseltme", IDC_UPDATE, 7, 80, 277, 10
    LTEXT "ReactOS'un yeni bir kopyasını yükler. Bu seçenek; dosyalarınızı, ayarlarınızı ve programlarınızı korumaz. Disklere ve bölümlere değişiklikler yapabilirsiniz.", IDC_INSTALLTEXT, 19, 36, 279, 27
    LTEXT "Kurulu olan ReactOS'u günceller ya da onarır. Bu seçenek; dosyalarınızı, ayarlarınızı ve programlarınızı korur. Bu seçenek yalnızca ReactOS bu bilgisayarda önceden kuruluysa kullanılabilir.", IDC_UPDATETEXT, 19, 96, 279, 27
END

IDD_UPDATEREPAIRPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Kurulum Yöneticisi aşağıda listelenen ReactOS kurulumlarından birini yükseltebilir ya da eğer ReactOS kurulumu zarar görmüşse onu onarmaya çalışabilir.", IDC_STATIC, 6, 6, 303, 18
    CONTROL     "", IDC_NTOSLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP, 6, 30, 303, 90
    PUSHBUTTON  "&Yükseltme yapma", IDC_SKIPUPGRADE, 230, 128, 80, 14
    LTEXT       "Seçilen işletim sistemi kurulumu için İleri'ye ya da yükseltme yapmadan yeni bir kuruluma devam etmek için 'Yükseltme yapma'ya tıklayınız.", IDC_STATIC, 7, 124, 222, 16
END

IDD_DEVICEPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Bilgisayar:", IDC_STATIC, 20, 15, 80, 10
    COMBOBOX IDC_COMPUTER, 100, 15, 180, 80, WS_VSCROLL | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "&Ekran:", IDC_STATIC, 20, 35, 80, 10
    COMBOBOX IDC_DISPLAY, 100, 35, 180, 80, WS_VSCROLL | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "&Klavye:", IDC_STATIC, 20, 55, 80, 10
    COMBOBOX IDC_KEYBOARD, 100, 55, 180, 80, WS_VSCROLL | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "Kurulum aygıtlarını onaylayıp devam etmek için İleri'ye tıklayınız.", IDC_STATIC, 7, 128, 297, 8
END

IDD_DRIVEPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_PARTITION, "SysTreeList32", WS_BORDER | WS_VISIBLE | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL, 7, 7, 303, 112
    PUSHBUTTON "&Başlat", IDC_INITDISK, 7, 122, 50, 14, WS_GROUP // NOTE: At same position as IDC_PARTCREATE
    PUSHBUTTON "&Oluştur...", IDC_PARTCREATE, 7, 122, 50, 14
    PUSHBUTTON "&Biçimlendir", IDC_PARTFORMAT, 7, 122, 50, 14 // NOTE: At same position as IDC_PARTCREATE
    PUSHBUTTON "&Sil", IDC_PARTDELETE, 63, 122, 50, 14
    PUSHBUTTON "S&ürücü", IDC_DEVICEDRIVER, 174, 122, 50, 14, WS_DISABLED
    PUSHBUTTON "G&elişmiş Seçenekler...", IDC_PARTMOREOPTS, 230, 122, 80, 14
    // LTEXT "Kurulum özetini gözden geçirmek için İleri'ye tıklayınız.", IDC_STATIC, 7, 128, 277, 8
END

IDD_PARTITION DIALOGEX 0, 0, 200, 120
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bölüm Oluşturma ve Biçimlendirme"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Boyut:", IDC_STATIC, 7, 9, 70, 9
    EDITTEXT IDC_EDIT_PARTSIZE, 82, 7, 47, 13, ES_RIGHT | ES_NUMBER | WS_GROUP
    CONTROL "", IDC_UPDOWN_PARTSIZE, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT |
            UDS_AUTOBUDDY | UDS_ARROWKEYS | WS_GROUP, 120, 22, 9, 13
    LTEXT "MB", IDC_UNIT, 134, 9, 14, 9
    AUTOCHECKBOX "&Genişletilmiş bölüm", IDC_CHECK_MBREXTPART, 7, 22, 180, 14
    LTEXT "&Dosya sistemi:", IDC_FS_STATIC, 7, 46, 70, 9
    COMBOBOX IDC_FSTYPE, 82, 44, 100, 50, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&Hızlı biçimlendirme", IDC_CHECK_QUICKFMT, 7, 59, 180, 14
    PUSHBUTTON "Tamam", IDOK, 88, 98, 50, 14
    PUSHBUTTON "İptal", IDCANCEL, 143, 98, 50, 14
END

IDD_FORMAT DIALOGEX 0, 0, 200, 83
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bölüm Biçimlendirme"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Dosya sistemi:", IDC_FS_STATIC, 7, 9, 70, 9
    COMBOBOX IDC_FSTYPE, 82, 7, 100, 50, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&Hızlı biçimlendirme", IDC_CHECK_QUICKFMT, 7, 22, 180, 14
    PUSHBUTTON "Tamam", IDOK, 88, 61, 50, 14
    PUSHBUTTON "İptal", IDCANCEL, 143, 61, 50, 14
END

IDD_ADVINSTOPTS DIALOGEX 0, 0, 305, 135
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gelişmiş Kurulum Seçenekleri"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "ReactOS'u kurmak istediğiniz &dizini seçiniz:", IDC_STATIC, 7, 9, 291, 10
    EDITTEXT IDC_PATH, 7, 23, 291, 13
    GROUPBOX "Önyükleyici", IDC_STATIC, 7, 45, 291, 60
    LTEXT "FreeLoader önyükleyicisinin kurulacağı konumu seçiniz.\n\nVarsayılan olarak önyükleme diskinin sistem bölümüne (ve BIOS tabanlı bilgisayarlarda Ana ya da Birim Önyükleme Kaydına) kurulur.", IDC_STATIC, 13, 57, 279, 44
    COMBOBOX IDC_INSTFREELDR, 150, 58, 142, 45, WS_VSCROLL | WS_TABSTOP | CBS_DROPDOWNLIST
    DEFPUSHBUTTON "Tamam", IDOK, 193, 113, 50, 14
    PUSHBUTTON "İptal", IDCANCEL, 248, 113, 50, 14
END

IDD_SUMMARYPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Kurulum türü:", IDC_STATIC, 18, 5, 74, 11
    EDITTEXT IDC_INSTALLTYPE, 95, 5, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Kurulum kaynağı:", IDC_STATIC, 18, 17, 74, 11
    EDITTEXT IDC_INSTALLSOURCE, 95, 17, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Mimari:", IDC_STATIC, 18, 29, 74, 11
    EDITTEXT IDC_ARCHITECTURE, 95, 29, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Bilgisayar:", IDC_STATIC, 18, 41, 74, 11
    EDITTEXT IDC_COMPUTER, 95, 41, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Ekran:", IDC_STATIC, 18, 53, 74, 11
    EDITTEXT IDC_DISPLAY, 95, 53, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Klavye:", IDC_STATIC, 18, 65, 74, 11
    EDITTEXT IDC_KEYBOARD, 95, 65, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Hedef disk bölümü:", IDC_STATIC, 18, 77, 74, 11
    EDITTEXT IDC_DESTDRIVE, 95, 77, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Hedef dizin:", IDC_STATIC, 18, 89, 74, 11
    EDITTEXT IDC_PATH, 95, 89, 210, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    AUTOCHECKBOX "Bütün kurulum ayarlarının doğru olduğunu onaylıyorum. Ayrıca, ReactOS'un alfa durumunda yazılım olduğunu ve bilgisayarımı ya da verilerimi bozabileceğini kabul ediyorum.",
        IDC_CONFIRM_INSTALL, 7, 100, 309, 24, BS_MULTILINE | WS_GROUP | WS_TABSTOP
    LTEXT "Lütfen bütün kurulum ayarlarının doğru olduğundan emin olunuz,\nardından kurulum işlemine başlamak için Kur'a tıklayınız.", IDC_STATIC, 7, 124, 303, 18
END

IDD_PROCESSPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Dosyalar kopyalanıyor...", IDC_ACTIVITY, 20, 35, 277, 10
    LTEXT "test.txt", IDC_ITEM, 20, 83, 277, 10
    CONTROL "", IDC_PROCESSPROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 20, 97, 277, 11
END

IDD_FINISHPAGE DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Bilgisayarınız Yeniden Başlatılıyor", IDC_FINISHTITLE, 115, 8, 195, 24
    LTEXT "İlk ReactOS kurulum aşaması başarıyla tamamlandı.", IDC_STATIC, 115, 40, 195, 24
    // The following text can be replaced by IDS_FINISH_NO_REBOOT at runtime;
    // please ensure it can hold in the text control!
    LTEXT "Kurulum, ikinci aşamaya geçmek için bilgisayarınızı yeniden başlatacak.\n\nBilgisayarınız 15 saniye içinde veya Yeniden Başlat'a tıkladığınızda otomatik olarak yeniden başlatılacaktır.", IDC_FINISHTEXT, 115, 78, 195, 56
    CONTROL "", IDC_RESTART_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 115, 135, 188, 12
END

IDD_ABORTPAGE DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "ReactOS Kurulum Sihirbazı beklenmedik şekilde sona erdi", IDC_FINISHTITLE, 115, 8, 195, 24
    LTEXT "ReactOS'un ilk kurulum aşaması bir hata nedeniyle veya işlemi iptal etmenizden dolayı erkenden sona erdi.\n\nReactOS'u kurmak veya yükseltmek için Kurulum Sihirbazı'nı daha sonra yeniden çalıştırabilirsiniz.", IDC_STATIC, 115, 40, 195, 48
    // The following text can be replaced by IDS_ABORT_NO_REBOOT at runtime;
    // please ensure it can hold in the text control!
    LTEXT "Bilgisayarınız 15 saniye içinde veya Yeniden Başlat'a tıkladığınızda otomatik olarak yeniden başlatılacaktır.", IDC_FINISHTEXT, 115, 110, 195, 24
    CONTROL "", IDC_RESTART_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 115, 135, 188, 12
END

