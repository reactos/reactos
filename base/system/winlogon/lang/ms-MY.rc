LANGUAGE LANG_MALAY, SUBLANG_DEFAULT

IDD_SHUTDOWNCOMPUTER DIALOGEX 45, 22, 164, 52
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Tutup Komputer"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Kini selamat untuk mematikan komputer anda.", IDC_SHUTDOWNCOMPUTER, 31, 6, 132, 18
    ICON IDI_WINLOGON, IDC_SHTDOWNICON, 6, 7, 18, 20
    DEFPUSHBUTTON "Mula &Semula", IDC_BTNSHTDOWNCOMPUTER, 52, 32, 60, 14
END

IDD_GINALOADFAILED DIALOGEX 58, 83, 231, 119
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Kegagalan Antara Muka Pengguna"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Antara Muka Pengguna Log Masuk DLL %s gagal untuk dimuatkan.", IDC_GINALOADFAILED, 39, 16, 156, 24
    LTEXT "Hubungi pentadbir sistem anda untuk menggantikan DLL, atau memulihkan DLL yang asal.", IDC_GINALOADFAILEDCONTACT, 39, 53, 151, 25
    DEFPUSHBUTTON "Mula &Semula", IDOK, 80, 91, 68, 14
END

IDD_SYSSHUTDOWN DIALOGEX 50, 50, 180, 140
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_VISIBLE | WS_CAPTION | WS_POPUP
CAPTION "Tutup Sistem"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_WARNING, IDC_SYSSHUTDOWNICON, 6, 7, 18, 20
    LTEXT "Penutupan sistem telah dimulakan. Sila simpan semua kerja anda dan tamatkan sesi anda. Semua kerja yang belum disimpan akan hilang apabila sistem dimatikan.", IDC_STATIC, 38, 7, 135, 40
    LTEXT "Sistem akan ditutup dalam:", IDC_STATIC, 38, 50, 90, 8
    LTEXT "00:00:00", IDC_SYSSHUTDOWNTIMELEFT, 132, 50, 41, 8
    LTEXT "Mesej:", IDC_STATIC, 38, 65, 135, 8
    EDITTEXT IDC_SYSSHUTDOWNMESSAGE, 34, 75, 139, 58, ES_LEFT | ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP, WS_EX_STATICEDGE
END

STRINGTABLE
BEGIN
    IDS_PREPARENETWORKCONNECTIONS "Menyediakan sambungan rangkaian..."
    IDS_APPLYINGCOMPUTERSETTINGS "Sedang menggunakan tetapan komputer..."
    IDS_RUNNINGSTARTUPSCRIPTS "Sedang menjalankan skrip permulaan..."
    IDS_RUNNINGSHUTDOWNSCRIPTS "Sedang menjalankan skrip penutupan..."
    IDS_APPLYINGYOURPERSONALSETTINGS "Sedang menggunakan tetapan peribadi anda..."
    IDS_RUNNINGLOGOFFSCRIPTS "Sedang menjalankan skrip log keluar..."
    IDS_RUNNINGLOGONSCRIPTS "Sedang menjalankan skrip log masuk..."
    IDS_LOADINGYOURPERSONALSETTINGS "Sedang memuatkan tetapan peribadi anda..."
    IDS_CLOSINGNETWORKCONNECTIONS "Sedang menutup sambungan rangkaian..."
    IDS_REACTOSISRESTARTING "Sedang memulakan semula..."
    IDS_REACTOSISSHUTTINGDOWN "Sedang menutup..."
    IDS_PREPARETOSTANDBY "Bersedia untuk tunggu sedia..."
    IDS_PREPARETOHIBERNATE "Bersedia untuk berhibernasi..."
    IDS_SAVEYOURSETTINGS "Sedang menyimpan tetapan anda..."
    IDS_REACTOSISSTARTINGUP "ReactOS sedang bermula komputer anda..."
    IDS_LOGGINGOFF "Sedang log keluar..."
    IDS_TIMEOUTSHORTFORMAT "%02d:%02d:%02d"
    IDS_TIMEOUTLONGFORMAT "%d hari"
END

STRINGTABLE
BEGIN
    IDS_FAILEDACTIVATEUSERSHELL "Winlogon gagal mengaktifkan shell pengguna!"
END
