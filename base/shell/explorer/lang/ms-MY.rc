LANGUAGE LANG_MALAY, SUBLANG_DEFAULT

IDM_TRAYWND MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "Su&ai Tarikh/Masa", ID_SHELL_CMD_ADJUST_DAT
        MENUITEM "Menyesuaikan &Notifikasi...", ID_SHELL_CMD_CUST_NOTIF
        MENUITEM SEPARATOR
        MENUITEM "Tetingkap &Lata", ID_SHELL_CMD_CASCADE_WND
        MENUITEM "Tetingkap Jubin Melin&tang", ID_SHELL_CMD_TILE_WND_H
        MENUITEM "Tetingkap Jubin Men&egak", ID_SHELL_CMD_TILE_WND_V
        MENUITEM "Papar De&sktop", ID_SHELL_CMD_SHOW_DESKTOP
        MENUITEM "B&uat Asal", ID_SHELL_CMD_UNDO_ACTION
        MENUITEM SEPARATOR
        MENUITEM "Pengu&rus Tugas", ID_SHELL_CMD_OPEN_TASKMGR
        MENUITEM SEPARATOR
        MENUITEM "&Kunci Bar Tugas", ID_LOCKTASKBAR
        MENUITEM "Si&fat-sifat", ID_SHELL_CMD_PROPERTIES
    END
END

IDM_STARTMENU MENUEX
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "", -1, MFT_SEPARATOR
        POPUP "&Program", IDM_PROGRAMS
        BEGIN
            MENUITEM "(Kosong)", -1, MFT_STRING, MFS_GRAYED
        END
        POPUP "&Kegemaran", IDM_FAVORITES
        BEGIN
            MENUITEM "(Kosong)", -1, MFT_STRING, MFS_GRAYED
        END
        POPUP "&Dokumen", IDM_DOCUMENTS
        BEGIN
            MENUITEM "(Kosong)", -1, MFT_STRING, MFS_GRAYED
        END
        POPUP "T&etapan", IDM_SETTINGS
        BEGIN
            MENUITEM "Pa&nel Kawalan", IDM_CONTROLPANEL, MFT_STRING, MFS_GRAYED
            MENUITEM "", -1, MFT_SEPARATOR
            MENUITEM "Ke&selamatan...", IDM_SECURITY, MFT_STRING, MFS_ENABLED
            MENUITEM "Sambungan &Rangkaian", IDM_NETWORKCONNECTIONS, MFT_STRING, MFS_ENABLED
            MENUITEM "&Pencetak and Faks", IDM_PRINTERSANDFAXES, MFT_STRING, MFS_ENABLED
            MENUITEM "Bar &Tugas dan Menu Mula", IDM_TASKBARANDSTARTMENU, MFT_STRING, MFS_ENABLED
        END
        MENUITEM "&Cari", IDM_SEARCH, MFT_STRING, MFS_ENABLED
        MENUITEM "&Bantuan dan Sokongan", IDM_HELPANDSUPPORT, MFT_STRING, MFS_ENABLED
        MENUITEM "&Jalankan...", IDM_RUN, MFT_STRING, MFS_ENABLED
        MENUITEM "", 450, MFT_SEPARATOR, MFS_ENABLED
        MENUITEM "Se&gerakkan", IDM_SYNCHRONIZE, MFT_STRING, MFS_ENABLED
        MENUITEM "&Log Keluar %s...", IDM_LOGOFF, MFT_STRING, MFS_ENABLED
        MENUITEM "P&utuskan Sambungan...", IDM_DISCONNECT, MFT_STRING, MFS_ENABLED
        MENUITEM "&Membuka Dok Komputer", IDM_UNDOCKCOMPUTER, MFT_STRING, MFS_ENABLED
        MENUITEM "&Tutupkan Komputer", IDM_SHUTDOWN, MFT_STRING, MFS_ENABLED
    END
END

IDD_TASKBARPROP_TASKBAR DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Bar Tugas"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX "Penampilan Bar Tugas", IDC_STATIC, 6, 6, 240, 120
    CONTROL "", IDC_TASKBARPROP_TASKBARBITMAP, "Static", SS_BITMAP | SS_SUNKEN | SS_CENTERIMAGE, 12, 18, 229, 24
    AUTOCHECKBOX "Kun&ci Bar Tugas", IDC_TASKBARPROP_LOCK, 13, 45, 200, 10
    AUTOCHECKBOX "&Auto-sembunyi bar tugas", IDC_TASKBARPROP_HIDE, 13, 58, 200, 10
    AUTOCHECKBOX "Simpan &bar tugas ini di atas tetingkap lain", IDC_TASKBARPROP_ONTOP, 13, 71, 200, 10
    AUTOCHECKBOX "&Kumpul butang bar tugas yang sama", IDC_TASKBARPROP_GROUP, 13, 84, 200, 10
    AUTOCHECKBOX "Paparkan Lancar &Pantas", IDC_TASKBARPROP_SHOWQL, 13, 97, 200, 10
    AUTOCHECKBOX "&Guna Ikon Kecil", IDC_TASKBARPROP_SMALLICONS, 13, 110, 200, 10
END

IDD_TASKBARPROP_STARTMENU DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Menu Mula"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL "", IDC_TASKBARPROP_STARTMENU_BITMAP, "Static", SS_BITMAP | SS_SUNKEN,7, 7, 183, 108
    AUTORADIOBUTTON "M&enu Mula", IDC_TASKBARPROP_STARTMENU, 7, 135, 105, 10
    LTEXT "Gaya menu ini memberi anda akses mudah ke folder, program kegemaran, dan carian anda.", IDC_TASKBARPROP_STARTMENUMODERNTEXT, 20, 145, 150, 24
    PUSHBUTTON "S&uaikan...", IDC_TASKBARPROP_STARTMENUCUST, 192, 132, 53, 14
    AUTORADIOBUTTON "&Menu Mula Klasik", IDC_TASKBARPROP_STARTMENUCLASSIC, 7, 175, 105, 10
    LTEXT "Gaya menu ini memberikan anda rupa dan fungsi klasik", IDC_TASKBARPROP_STARTMENUCLASSICTEXT, 20, 185, 150, 24
    PUSHBUTTON "&Suaikan...", IDC_TASKBARPROP_STARTMENUCLASSICCUST, 192, 172, 53, 14
END

IDD_TASKBARPROP_NOTIFY DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Kawasan Notifikasi"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL "", IDC_TASKBARPROP_NOTIFICATIONBITMAP, "Static", SS_BITMAP | SS_SUNKEN | SS_CENTERIMAGE, 12, 6, 229, 24
    GROUPBOX "Ikon", IDC_STATIC, 6, 36, 240, 56
    LTEXT "Anda boleh memastikan kawasan notifikasi tidak bersepah dengan menyembunyikan ikon yang anda tidak klik baru-baru ini.", IDC_STATIC, 13, 48, 223, 16
    AUTOCHECKBOX "&Sembunyikan ikon yang tidak aktif", IDC_TASKBARPROP_HIDEICONS, 13, 70, 125, 10
    PUSHBUTTON "S&uaikan...", IDC_TASKBARPROP_ICONCUST, 188, 70, 50, 14
    GROUPBOX "Ikon sistem", IDC_STATIC, 6, 99, 240, 56
    LTEXT "Pilih ikon sistem yang hendak sentiasa dipaparkan.", IDC_STATIC, 13, 113, 223, 8
    AUTOCHECKBOX "Tunjukkan ja&m", IDC_TASKBARPROP_CLOCK, 13, 127, 80, 10
    AUTOCHECKBOX "Tunjukkan saa&t", IDC_TASKBARPROP_SECONDS, 120, 127, 80, 10, WS_DISABLED
    AUTOCHECKBOX "&Desktop", IDC_TASKBARPROP_DESKTOP, 13, 140, 80, 10
END

IDD_NOTIFICATIONS_CUSTOMIZE DIALOGEX 0, 0, 232, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_DLGFRAME
EXSTYLE WS_EX_CONTEXTHELP
CAPTION "Sesuaikan Notifikasi"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT            "ReactOS memaparkan ikon untuk notifikasi aktif dan mendesak, dan menyembunyikan yang tidak aktif. Anda boleh menukar tingkah laku ini untuk item dalam senarai di bawah.", IDC_STATIC, 6, 6, 220, 30
    LTEXT            "Pilih item, kemudian pilih tingkah laku notifikasi:", IDC_STATIC, 6, 40, 220, 10
    CONTROL          "", IDC_NOTIFICATION_LIST, "SysListView32", WS_CLIPSIBLINGS | WS_BORDER | 0x00008005, 6, 50, 220, 128
    COMBOBOX         IDC_NOTIFICATION_BEHAVIOUR, 103, 178, 78, 200, CBS_DROPDOWNLIST | NOT WS_VISIBLE | WS_CLIPSIBLINGS
    PUSHBUTTON       "Pulihkan Tetapan &Asal", IDC_TASKBARPROP_NOTIREST, 164, 188, 62, 14
    DEFPUSHBUTTON    "OK", IDOK, 122, 220, 50, 14
    PUSHBUTTON       "Batal", IDCANCEL, 176, 220, 50, 14
END

IDD_CLASSICSTART_CUSTOMIZE DIALOGEX 0, 0, 232, 240, 0
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_DLGFRAME
CAPTION "Suai Menu Mula Klasik"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX         "Menu mula", IDC_STATIC, 8, 7, 218, 114
    ICON             IDI_STARTMENU2, IDC_STATIC, 19, 17, 20, 20
    LTEXT            "Anda boleh menyesuaikan menu Mula anda dengan menambah atau mengalih keluar item.", IDC_STATIC, 48, 17, 108, 39
    PUSHBUTTON       "Ta&mbah", IDC_CLASSICSTART_ADD, 162, 18, 53, 14
    PUSHBUTTON       "&Alih keluar...", IDC_CLASSICSTART_REMOVE, 162, 33, 53, 14
    PUSHBUTTON       "&Lanjutan", IDC_CLASSICSTART_ADVANCED, 162, 49, 53, 14
    PUSHBUTTON       "&Isih", IDC_CLASSICSTART_SORT, 162, 65, 53, 14
    ICON             IDI_RECYCLEBIN, IDC_STATIC, 20, 85, 20, 20
    LTEXT            "Untuk mengalih keluar rekod dokumen, program dan laman web yang telah diakses baru-baru ini, klik Kosongkan.", IDC_STATIC, 49, 85, 108, 33
    PUSHBUTTON       "&Kosongkan", IDC_CLASSICSTART_CLEAR, 162, 94, 53, 14
    LTEXT            "Pilihan menu M&ula Lanjutan:", IDC_STATIC, 8, 129, 150, 8
    CONTROL          "StartMenuSe&ttings", IDC_CLASSICSTART_SETTINGS, "SysTreeView32", TVS_HASBUTTONS | WS_BORDER, 8, 139, 218, 72, WS_EX_CLIENTEDGE
    DEFPUSHBUTTON    "OK", IDOK, 122, 220, 50, 14
    PUSHBUTTON       "Batal", IDCANCEL, 176, 220, 50, 14
END

IDD_FILENAME_WARNING DIALOGEX 0, 0, 272, 81, 0
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Amaran Nama Fail"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON    "&Abaikan", IDIGNORE, 215, 60, 50, 14
    PUSHBUTTON       "&Tukar Nama", IDC_FILE_RENAME, 159, 60, 50, 14
    LTEXT            "", IDC_STATIC, 7, 51, 258, 1, NOT WS_GROUP
    AUTOCHECKBOX     "&Jangan lakukan semakan ini semasa permulaan", IDC_NOTCHECK, 7, 62, 139, 10
    ICON             32515, IDC_STATIC, 7, 7, 21, 20
    LTEXT            "Terdapat sebuah fail atau folder pada komputer anda yang dipanggil %s yang boleh menyebabkan beberapa aplikasi tidak berfungsi dengan betul.  Menamakannya semula kepada %s akan menyelesaikan masalah ini.  Adakah anda ingin menamakannya semula sekarang?", IDC_STATIC, 34, 7, 224, 37
END

IDD_MODERNSTART_ADVANCED DIALOGEX 0, 0, 251, 198, 0
STYLE DS_SETFONT | WS_CAPTION | WS_CHILD | WS_DISABLED
CAPTION "Lanjutan"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX         "Tetapan menu mula ", IDC_STATIC, 7, 7, 238, 42
    AUTOCHECKBOX     "&Buka submenu apabila saya berhenti seketika padanya dengan tetikus saya", IDC_AUTOOPEN, 14, 21, 224, 10
    AUTOCHECKBOX     "Serlahkan program yang baru di&pasang", IDC_HIGHLIGHT, 14, 35, 224, 10
    LTEXT            "Item &menu mula:", IDC_STATIC, 7, 53, 238, 8
    CONTROL          "StartMenuSe&ttings", IDC_ITEMS, "SysTreeView32", WS_BORDER | 0x00000001, 7, 63, 238, 67, WS_EX_CLIENTEDGE
    GROUPBOX         "Dokumen terkini ", IDC_STATIC, 7, 133, 238, 56
    LTEXT            "Pilih pilihan ini untuk memberikan akses pantas kepada dokumen yang anda buka baru-baru ini. Mengosongkan senarai ini tidak akan memadamkan dokumen tersebut.", IDC_STATIC, 14, 144, 224, 21
    AUTOCHECKBOX     "Senaraikan dokumen yang paling ba&ru saya buka", IDC_RECENTLY, 14, 168, 147, 10
    PUSHBUTTON       "&Kosongkan Senarai", IDC_CLEAR, 182, 168, 55, 14
END

IDD_MODERNSTART_GENERAL DIALOGEX 0, 0, 251, 198
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Umum"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX         "Pilih saiz ikon untuk program ", IDC_STATIC, 7, 7, 238, 37
    ICON             IDC_LARGEICON, 17, 18, 20, 20, SS_CENTERIMAGE
    ICON             IDC_SMALLICON, 151, 18, 20, 20, SS_CENTERIMAGE
    AUTORADIOBUTTON  "Ikon &besar", IDC_CHOOSELARGE, 43, 25, 53, 10
    AUTORADIOBUTTON  "Ikon ke&cil", IDC_CHOOSESMALL, 177, 25, 51, 10, NOT WS_TABSTOP
    GROUPBOX         "Program ", IDC_STATIC, 7, 49, 238, 70
    LTEXT            "Menu mula mengandungi pintasan ke program yang paling kerap anda gunakan. Mengosongkan senarai pintasan tidak akan memadamkan program tersebut.", IDC_STATIC, 14, 63, 224, 20
    LTEXT            "Bilanga&n program pada menu Mula:", IDC_STATIC, 14, 86, 112, 8
    EDITTEXT         IDC_NUMBEROFPROGRAMS, 133, 84, 27, 12, ES_LEFT | ES_RIGHT | ES_NUMBER
    CONTROL          "", IDC_NUMBERUPDOWN, "msctls_updown32", WS_BORDER | 0x000000B6, 160, 84, 11, 12
    PUSHBUTTON       "&Kosongkan Senarai", IDC_CLEARLIST, 182, 98, 57, 14
    GROUPBOX         "Tunjukkan pada menu Mula ", IDC_STATIC, 7, 126, 238, 63
    AUTOCHECKBOX     "&Internet:", IDC_SHOWINTERNET, 14, 140, 42, 10
    COMBOBOX         IDC_INTERNETDEFAULTAPP, 98, 138, 140, 200, CBS_DROPDOWNLIST | WS_VSCROLL
    AUTOCHECKBOX     "&E-mel:", IDC_SHOWEMAIL, 14, 157, 37, 10
    COMBOBOX         IDC_EMAILDEFAULTAPP, 98, 155, 140, 200, CBS_DROPDOWNLIST | WS_VSCROLL
END

