/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Spill"
    BEGIN
        MENUITEM "&Del ut\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Angre\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Hint\tF3", IDM_GAME_HINT
        MENUITEM "Kort&stokk...", IDM_GAME_DECK
        MENUITEM "&Valg...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Beste resultater...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&Avslutt", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Samle kort", IDM_GAME_FINISH, GRAYED
    POPUP "&Hjelp"
    BEGIN
        MENUITEM "&Emner i hjelp\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Om", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
