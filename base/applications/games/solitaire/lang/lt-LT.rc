LANGUAGE LANG_LITHUANIAN, SUBLANG_DEFAULT

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Nuostatos"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Kortos", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "Dalinti po &vieną", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Dalinti po &tris", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    // TRANSLATORS: Machine translation of previously English text; please review.
    GROUPBOX "Taškai", -1, 150, 7, 143, 53
    // TRANSLATORS: Machine translation of previously English text; please review.
    AUTORADIOBUTTON "&Standartinis", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Vegas", IDC_OPT_VEGAS, 157, 32, 126, 10
    // TRANSLATORS: Machine translation of previously English text; please review.
    AUTORADIOBUTTON "&Neskaičiuoti", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "&Rodyti laiką", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "&Būsenos juosta", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation of previously English text; please review.
    AUTOCHECKBOX "&Išlaikyti taškus", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation; please review this new text.
    LTEXT "Atšaukiami ėjimai (0 = išjungta):", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Pergalės animacija...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "Gerai", IDOK, 82, 139, 60, 14
    PUSHBUTTON "Atsisakyti", IDCANCEL, 158, 139, 60, 14
END

// TRANSLATORS: The following dialog is machine-translated; please review all new text.
IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Pergalės animacija"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "Lange (klasikinė)", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Šiame monitoriuje", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "Visuose monitoriuose", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "Greitis", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "Numatyta: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Peržiūra (5 sekundės)", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "Gerai", IDOK, 72, 181, 54, 14
    PUSHBUTTON "Atsisakyti", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "Kortų viršelio pasirinkimas"
FONT 8, "MS Shell Dlg"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "Gerai", IDOK, 114, 165, 54, 14
    PUSHBUTTON "Atsisakyti", IDCANCEL, 176, 165, 54, 14
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitaire"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_ABOUT "Solitaire sukurta J Brown\nCardLib versija 1.0"
    IDS_SOL_QUIT "Baigti žaidimą?"
    IDS_SOL_WIN "Sveikiname, jūs laimėjote!!"
    IDS_SOL_DEAL "Dalinti vėl?"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_SCORE "Taškai: %d"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_TIME "Laikas: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Tiesioginio ėjimo nerasta."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Žaidimas"
    BEGIN
        MENUITEM "&Dalinti\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Atšaukti\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Patarimas\tF3", IDM_GAME_HINT
        MENUITEM "&Malka...", IDM_GAME_DECK
        MENUITEM "&Nuostatos...", IDM_GAME_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "&Baigti", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Surinkti kortas", IDM_GAME_FINISH, GRAYED
    POPUP "&Pagalba"
    BEGIN
        MENUITEM "&Turinys\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Apie", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
