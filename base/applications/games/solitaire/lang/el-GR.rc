END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Πασιέντζα"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_ABOUT "Πασιέντζα από τον J Brown\nCardLib έκδοση 1.0"
    IDS_SOL_QUIT "Τερματισμός του πιαχνιδιού αυτού;"
    IDS_SOL_WIN "Συγχαρητήρια, κερδίσατε!!"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_DEAL "Νέα μοιρασιά;"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_SCORE "Βαθμολογία: %d"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_TIME "Χρόνος: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Δεν βρέθηκε άμεση κίνηση."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Παιχνίδι"
    BEGIN
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Μοίρασμα\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Αναίρεση\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Υπόδειξη\tF3", IDM_GAME_HINT
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Τράπουλα...", IDM_GAME_DECK
        MENUITEM "&Επιλογές...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Καλύτερες βαθμολογίες...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "Έ&ξοδος", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Ολοκλήρωση", IDM_GAME_FINISH, GRAYED
    POPUP "&Βοήθεια"
    BEGIN
        MENUITEM "&Περιεχόμενα\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Σχετικά", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Καλύτερες βαθμολογίες"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Όνομα:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Αποθήκευση και νέο μοίρασμα", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Αποθήκευση και έξοδος", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Όνομα"
    IDS_HOF_PLACEMENT "#%lu — %ld Βαθμολογία"
END
