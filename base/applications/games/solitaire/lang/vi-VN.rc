/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "Trò &chơi"
    BEGIN
        MENUITEM "&Chia bài\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Hoàn tác\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Gợi ý\tF3", IDM_GAME_HINT
        MENUITEM "&Mặt sau...", IDM_GAME_DECK
        MENUITEM "&Tùy chọn...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Điểm cao nhất...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "Th&oát", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Thu bài", IDM_GAME_FINISH, GRAYED
    POPUP "Trợ &giúp"
    BEGIN
        MENUITEM "&Nội dung\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Giới thiệu", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Điểm cao nhất"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Tên:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Lưu và chia lại bài", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Lưu và thoát", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Tên"
    IDS_HOF_PLACEMENT "#%lu — %ld Điểm"
END
