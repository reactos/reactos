END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitaire"
    IDS_SOL_ABOUT "Solitaire av J Brown; Översätt av Ronny K Svensson\nCardLib version 1.0"
    IDS_SOL_QUIT "Avsluta nuvarande spel?"
    IDS_SOL_WIN "Grattis, du vann!"
    IDS_SOL_DEAL "Ge igen?"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_SCORE "Poäng: %d"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_TIME "Tid: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Inget direkt drag hittades."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Spel"
    BEGIN
        MENUITEM "&Ge\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Ångra\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Tips\tF3", IDM_GAME_HINT
        MENUITEM "&Kortlek...", IDM_GAME_DECK
        MENUITEM "&Alternativ...", IDM_GAME_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "&Avsluta", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Samla kort", IDM_GAME_FINISH, GRAYED
    POPUP "&Hjälp"
    BEGIN
        MENUITEM "&Innehåll\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Om", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
