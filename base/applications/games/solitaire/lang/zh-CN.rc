/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "游戏(&G)"
    BEGIN
        MENUITEM "发牌(&D)\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "撤销(&U)\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "提示\tF3", IDM_GAME_HINT
        MENUITEM "背面图案(&C)...", IDM_GAME_DECK
        MENUITEM "选项(&O)...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "最高分...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "自动收牌", IDM_GAME_FINISH, GRAYED
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "目录(&C)\tF1", IDM_HELP_CONTENTS
        MENUITEM "关于纸牌(&A)", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
