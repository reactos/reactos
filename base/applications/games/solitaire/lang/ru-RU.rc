STRINGTABLE
BEGIN
    IDS_SOL_NAME "Пасьянс"
    IDS_SOL_ABOUT "Пасьянс от J Brown\nCardLib версии 1.0"
    IDS_SOL_QUIT "Закончить текущую игру?"
    IDS_SOL_WIN "Поздравляем, вы выиграли!"
    IDS_SOL_DEAL "Раздать ещё раз?"
    IDS_SOL_SCORE "Счёт: %d"
    IDS_SOL_TIME "Время: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Прямой ход не найден."
END

/* Меню */

IDR_MENU1 MENU
BEGIN
    POPUP "&Игра"
    BEGIN
        MENUITEM "Н&овая игра\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Отменить ход\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Подсказка\tF3", IDM_GAME_HINT
        MENUITEM "&Обложки...", IDM_GAME_DECK
        MENUITEM "&Настройки...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Лучшие результаты...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&Выход", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Собрать карты", IDM_GAME_FINISH, GRAYED
    POPUP "&Помощь"
    BEGIN
        MENUITEM "&Справка\tF1", IDM_HELP_CONTENTS
        MENUITEM "&О программе", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Лучшие результаты"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Имя:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Сохранить и раздать заново", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Сохранить и выйти", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Имя"
    IDS_HOF_PLACEMENT "#%lu — %ld Счёт"
END
