LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "オプション"
FONT 9, "MS UI Gothic"
BEGIN
    GROUPBOX "カード", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "1 枚ずつ取る(&O)", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "3 枚ずつ取る(&T)", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    GROUPBOX "得点方法", -1, 150, 7, 143, 53
    AUTORADIOBUTTON "標準(&S)", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "ベガス(&V)", IDC_OPT_VEGAS, 157, 32, 126, 10
    AUTORADIOBUTTON "なし(&N)", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "時間を表示する(&S)", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "ステータスバーを表示する(&T)", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    AUTOCHECKBOX "得点を保つ(&K)", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation; please review this new text.
    LTEXT "元に戻せる手数（0 = 無効）:", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "勝利アニメーション...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 82, 139, 60, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 158, 139, 60, 14
END

// TRANSLATORS: The following dialog is machine-translated; please review all new text.
IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "勝利アニメーション"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "ウィンドウ内（従来）", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "このモニター", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "すべてのモニター", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "速度", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "既定: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "プレビュー（5秒）", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "OK", IDOK, 72, 181, 54, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "カードの背景を選択"
FONT 9, "MS UI Gothic"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "OK", IDOK, 114, 165, 54, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 176, 165, 54, 14
END

// TRANSLATORS: Machine translation; please review this new high-score dialog and its strings.
IDD_HIGHSCORES DIALOGEX 0, 0, 420, 291
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "ハイスコア"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "得点方法", -1, 7, 10, 54, 12
    COMBOBOX IDC_HOF_MODE, 64, 7, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "時間を計測したゲーム", IDC_HOF_TIMED, 218, 10, 195, 12, WS_TABSTOP
    LTEXT "カード", -1, 7, 32, 54, 12
    COMBOBOX IDC_HOF_DRAW, 64, 29, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_HOF_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 54, 406, 168
    LTEXT "標準：勝利したゲーム。Vegas：終了したラウンドを累積残高とは別に採点します。各部門の上位10件を表示します。", -1, 7, 230, 406, 32
    DEFPUSHBUTTON "OK", IDOK, 180, 270, 60, 14
END

// TRANSLATORS: Machine translation; please review this new high-score dialog and its strings.
STRINGTABLE
BEGIN
    IDS_HOF_STANDARD "標準"
    IDS_HOF_VEGAS "ベガス"
    IDS_HOF_ONE "1 枚ずつ取る"
    IDS_HOF_THREE "3 枚ずつ取る"
    IDS_HOF_RANK "#"
    IDS_HOF_SCORE "得点"
    IDS_HOF_TIME "時間"
    IDS_HOF_DATE "日付"
    IDS_HOF_RESULT "結果"
    IDS_HOF_WON "勝利"
    IDS_HOF_ENDED "終了"
    IDS_HOF_SAVE_ERROR "得点を保存できませんでした。"
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "ソリティア"
    IDS_SOL_ABOUT "J Brown によるソリティア\nCardLib バージョン 1.0"
    IDS_SOL_QUIT "現在のゲームを終了しますか?"
    IDS_SOL_WIN "おめでとう、あなたの勝ちです!"
    IDS_SOL_DEAL "もう一度カードを配りますか?"
    IDS_SOL_SCORE "得点: %d"
    IDS_SOL_TIME "時間: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "直接移動できる手が見つかりません。"
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "ゲーム(&G)"
    BEGIN
        MENUITEM "カードを配る(&D)\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "元に戻す(&U)\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "ヒント\tF3", IDM_GAME_HINT
        MENUITEM "カードの装飾(&C)...", IDM_GAME_DECK
        MENUITEM "オプション(&O)...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "ハイスコア...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "終了(&E)", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "自動で片付ける", IDM_GAME_FINISH, GRAYED
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "目次(&C)\tF1", IDM_HELP_CONTENTS
        MENUITEM "バージョン情報(&A)", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
