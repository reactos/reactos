STRINGTABLE
BEGIN
    IDS_SOL_NAME "카드놀이"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_ABOUT "J Brown의 솔리테어\nCardLib 버전 1.0"
    IDS_SOL_QUIT "현재 게임을 끝낼가요?"
