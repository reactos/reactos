/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "게임(&G)"
    BEGIN
        MENUITEM "새 게임(&D)\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "실행 취소(&U)\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "힌트\tF3", IDM_GAME_HINT
        MENUITEM "덱(&C)...", IDM_GAME_DECK /* FIXME: is 덱 correct? */
        MENUITEM "옵션(&O)...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "최고 점수...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "종료(&E)", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "카드 모으기", IDM_GAME_FINISH, GRAYED
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "목차(&C)\tF1", IDM_HELP_CONTENTS
        MENUITEM "정보(&A)", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
