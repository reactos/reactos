LANGUAGE LANG_POLISH, SUBLANG_DEFAULT

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Opcje"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Karty", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "Rozdaj &jedną", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Rozdaj &dwie", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    GROUPBOX "Punktowanie", -1, 150, 7, 143, 53
    AUTORADIOBUTTON "&Standardowe", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Vegas", IDC_OPT_VEGAS, 157, 32, 126, 10
	 AUTORADIOBUTTON "&Brak", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "&Pokazuj czas gry", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "Pokazuj pa&sek stanu", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    AUTOCHECKBOX "Pamiętaj punkty", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation; please review this new text.
    LTEXT "Cofane ruchy (0 = wyłączone):", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Animacja zwycięstwa...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 82, 139, 60, 14
    PUSHBUTTON "Anuluj", IDCANCEL, 158, 139, 60, 14
END

// TRANSLATORS: The following dialog is machine-translated; please review all new text.
IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Animacja zwycięstwa"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "W oknie (klasyczna)", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Na tym monitorze", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "Na wszystkich monitorach", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "Szybkość", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "Domyślnie: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Podgląd (5 sekund)", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "OK", IDOK, 72, 181, 54, 14
    PUSHBUTTON "Anuluj", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "Wybieranie koszulki karty"
FONT 8, "MS Shell Dlg"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "OK", IDOK, 114, 165, 54, 14
    PUSHBUTTON "Anuluj", IDCANCEL, 176, 165, 54, 14
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Pasjans"
    IDS_SOL_ABOUT "Pasjans - autor: J. Brown\nCardLib wersja 1.0"
    IDS_SOL_QUIT "Zakończyć aktualną grę?"
    IDS_SOL_WIN "Gratulacje, wygrałeś!"
    IDS_SOL_DEAL "Nowe rozdanie?"
    IDS_SOL_SCORE "Wynik: %d"
    IDS_SOL_TIME "Czas: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Nie znaleziono bezpośredniego ruchu."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Gra"
    BEGIN
        MENUITEM "&Rozdaj\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Cofnij\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Podpowiedź\tF3", IDM_GAME_HINT
        MENUITEM "&Talia...", IDM_GAME_DECK
        MENUITEM "&Opcje...", IDM_GAME_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "&Zakończ", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Zbierz karty", IDM_GAME_FINISH, GRAYED
    POPUP "Pomo&c"
    BEGIN
        MENUITEM "&Spis treści\tF1", IDM_HELP_CONTENTS
        MENUITEM "Pasj&ans - informacje", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
