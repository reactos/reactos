LANGUAGE LANG_HEBREW, SUBLANG_DEFAULT

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "אפשרויות"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "משיכה", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "משוך &אחד", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "משוך &שלושה", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    GROUPBOX "ניקוד", -1, 150, 7, 143, 53
    AUTORADIOBUTTON "&רגיל", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&ווגאס", IDC_OPT_VEGAS, 157, 32, 126, 10
    AUTORADIOBUTTON "&ללא ניקוד", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "משחק קצוב בזמן", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "שורת מצב", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation of previously English text; please review.
    AUTOCHECKBOX "&שמירת ניקוד", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation; please review this new text.
    LTEXT "צעדי ביטול (0 = כבוי):", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "הנפשת ניצחון...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "אישור", IDOK, 82, 139, 60, 14
    PUSHBUTTON "ביטול", IDCANCEL, 158, 139, 60, 14
END

// TRANSLATORS: The following dialog is machine-translated; please review all new text.
IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "הנפשת ניצחון"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "בחלון (קלאסי)", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "בצג זה", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "בכל הצגים", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "מהירות", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "ברירת מחדל: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "תצוגה מקדימה (5 שניות)", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "אישור", IDOK, 72, 181, 54, 14
    PUSHBUTTON "ביטול", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "בחירת גב הקלפים"
FONT 8, "MS Shell Dlg"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
EXSTYLE WS_EX_LAYOUTRTL
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "אישור", IDOK, 114, 165, 54, 14
    PUSHBUTTON "ביטול", IDCANCEL, 176, 165, 54, 14
END

// TRANSLATORS: Machine translation; please review this new high-score dialog and its strings.
IDD_HIGHSCORES DIALOGEX 0, 0, 420, 291
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "התוצאות הטובות ביותר"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "ניקוד", -1, 7, 10, 54, 12
    COMBOBOX IDC_HOF_MODE, 64, 7, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "משחקים עם מדידת זמן", IDC_HOF_TIMED, 218, 10, 195, 12, WS_TABSTOP
    LTEXT "משיכה", -1, 7, 32, 54, 12
    COMBOBOX IDC_HOF_DRAW, 64, 29, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_HOF_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 54, 406, 168
    LTEXT "רגיל: משחקים שנוצחו. Vegas: סיבובים שהסתיימו, בניקוד נפרד מהיתרה המצטברת. עשר התוצאות הטובות בכל קטגוריה.", -1, 7, 230, 406, 32
    DEFPUSHBUTTON "אישור", IDOK, 180, 270, 60, 14
END

// TRANSLATORS: Machine translation; please review this new high-score dialog and its strings.
STRINGTABLE
BEGIN
    IDS_HOF_STANDARD "רגיל"
    IDS_HOF_VEGAS "ווגאס"
    IDS_HOF_ONE "משוך אחד"
    IDS_HOF_THREE "משוך שלושה"
    IDS_HOF_RANK "#"
    IDS_HOF_SCORE "ניקוד"
    IDS_HOF_TIME "זמן"
    IDS_HOF_DATE "תאריך"
    IDS_HOF_RESULT "תוצאה"
    IDS_HOF_WON "ניצחון"
    IDS_HOF_ENDED "הסתיים"
    IDS_HOF_SAVE_ERROR "לא ניתן לשמור את הניקוד."
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "סוליטייר"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_ABOUT "סוליטר מאת J Brown\nCardLib גרסה 1.0"
    IDS_SOL_QUIT "להפסיק את המשחק הנוכחי?"
    IDS_SOL_WIN "כל הכבוד, ניצחת!"
    IDS_SOL_DEAL "לחלק שוב?"
    IDS_SOL_SCORE "ניקוד: %d"
    IDS_SOL_TIME "זמן: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "לא נמצא מהלך ישיר."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&משחק"
    BEGIN
        MENUITEM "&חלק\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&ביטול מהלך\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "רמז\tF3", IDM_GAME_HINT
        MENUITEM "ח&פיסה...", IDM_GAME_DECK
        MENUITEM "&אפשרויות", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "התוצאות הטובות ביותר...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&יציאה", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "איסוף קלפים", IDM_GAME_FINISH, GRAYED
    POPUP "&עזרה"
    BEGIN
        MENUITEM "&תוכן העניינים\tF1", IDM_HELP_CONTENTS
        MENUITEM "&אודות", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
