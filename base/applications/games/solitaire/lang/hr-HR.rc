/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitaire"
    IDS_SOL_ABOUT "Solitaire od J Brown\nCardLib verzija 1.0"
    IDS_SOL_QUIT "Napusti trenutnu igru?"
    IDS_SOL_WIN "Čestitke, pobijedili ste!"
    IDS_SOL_DEAL "Ponovi?"
    IDS_SOL_SCORE "Rezultat: %d"
    IDS_SOL_TIME "Vrijeme: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Nije pronađen izravan potez."
