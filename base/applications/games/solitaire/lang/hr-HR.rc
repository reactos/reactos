/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Igra"
    BEGIN
        MENUITEM "Po&kreni\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Poništi\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Savjet\tF3", IDM_GAME_HINT
        MENUITEM "Špi&l...", IDM_GAME_DECK
        MENUITEM "&Opcije...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Najbolji rezultati...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&Izađi", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Dovrši", IDM_GAME_FINISH, GRAYED
    POPUP "&Pomoć"
    BEGIN
        MENUITEM "&Sadržaj\tF1", IDM_HELP_CONTENTS
        MENUITEM "&O Solitaire", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
