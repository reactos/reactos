/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitarioa"
    IDS_SOL_ABOUT "Solitarioa J Brown\nCardLib-k egina 1.0 bertsioa"
    IDS_SOL_QUIT "Uneko jokoa amaitu?"
    IDS_SOL_WIN "Zorionak, irabazi duzu!!"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_DEAL "Berriro banatu?"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_SCORE "Puntuak: %d"
    // TRANSLATORS: Machine translation of previously English text; please review.
    IDS_SOL_TIME "Denbora: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Ez da zuzeneko mugimendurik aurkitu."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Jokoa"
    BEGIN
        MENUITEM "&Banatu\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        // TRANSLATORS: Machine translation of previously English text; please review.
        MENUITEM "&Desegin\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Iradokizuna\tF3", IDM_GAME_HINT
        MENUITEM "&Barajak...", IDM_GAME_DECK
        MENUITEM "&Aukerak...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Puntuazio onenak...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&Irten", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Bildu kartak", IDM_GAME_FINISH, GRAYED
    POPUP "&Laguntza"
    BEGIN
        MENUITEM "&Edukia\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Solitariori buruz", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Puntuazio onenak"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Izena:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Gorde eta banatu berriro", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Gorde eta irten", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Izena"
    IDS_HOF_PLACEMENT "#%lu — %ld Puntuak"
END
