LANGUAGE LANG_GERMAN, SUBLANG_NEUTRAL

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Optionen"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Karten", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "&Eine ziehen", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Drei ziehen", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    GROUPBOX "Punkte zählen", -1, 150, 7, 143, 53
    AUTORADIOBUTTON "&Standard", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Vegas", IDC_OPT_VEGAS, 157, 32, 126, 10
    AUTORADIOBUTTON "Ke&ine", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "&Zeit anzeigen", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "S&tatusleiste", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    AUTOCHECKBOX "P&unkte behalten", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    LTEXT "Rückgängig-Schritte (0 = aus):", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    PUSHBUTTON "Siegesanimation...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 82, 139, 60, 14
    PUSHBUTTON "Abbrechen",IDCANCEL,158, 139, 60,14
END

IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Siegesanimation"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "Im Fenster (klassisch)", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Auf diesem Monitor", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "Auf allen Monitoren", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "Geschwindigkeit", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "Standard: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    PUSHBUTTON "Vorschau (5 Sekunden)", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "OK", IDOK, 72, 181, 54, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "Kartenhintergrund wählen"
FONT 8, "MS Shell Dlg"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "OK", IDOK, 114, 165, 54, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 176, 165, 54, 14
END

IDD_HIGHSCORES DIALOGEX 0, 0, 420, 291
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Bestenliste"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Punkte zählen", -1, 7, 10, 54, 12
    COMBOBOX IDC_HOF_MODE, 64, 7, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Mit Zeitwertung", IDC_HOF_TIMED, 218, 10, 195, 12, WS_TABSTOP
    LTEXT "Karten", -1, 7, 32, 54, 12
    COMBOBOX IDC_HOF_DRAW, 64, 29, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_HOF_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 54, 406, 168
    LTEXT "Standard: gewonnene Spiele. Vegas: beendete Runden, getrennt vom Gesamtstand gewertet. Die zehn besten Ergebnisse je Kategorie.", -1, 7, 230, 406, 32
    DEFPUSHBUTTON "OK", IDOK, 180, 270, 60, 14
END

STRINGTABLE
BEGIN
    IDS_HOF_STANDARD "Standard"
    IDS_HOF_VEGAS "Vegas"
    IDS_HOF_ONE "Eine ziehen"
    IDS_HOF_THREE "Drei ziehen"
    IDS_HOF_RANK "#"
    IDS_HOF_SCORE "Punkte"
    IDS_HOF_TIME "Zeit"
    IDS_HOF_DATE "Datum"
    IDS_HOF_RESULT "Ergebnis"
    IDS_HOF_WON "Gewonnen"
    IDS_HOF_ENDED "Beendet"
    IDS_HOF_SAVE_ERROR "Der Punktestand konnte nicht gespeichert werden."
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitär"
    IDS_SOL_ABOUT "Solitär von J Brown\nCardLib Version 1.0"
    IDS_SOL_QUIT "Laufendes Spiel beenden?"
    IDS_SOL_WIN "Glückwunsch, Sie haben gewonnen!"
    IDS_SOL_DEAL "Neu geben?"
    IDS_SOL_SCORE "Punkte: %d"
    IDS_SOL_TIME "Zeit: %d"
    IDS_SOL_NO_HINT "Kein direkter Zug gefunden."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Spiel"
    BEGIN
        MENUITEM "&Karten geben\t F2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Rückgängig\tStrg+Z", IDM_GAME_UNDO, GRAYED
        MENUITEM "Hinweis\tF3", IDM_GAME_HINT
        MENUITEM "&Deckblatt...", IDM_GAME_DECK
        MENUITEM "&Optionen...", IDM_GAME_OPTIONS
        MENUITEM "Bestenliste...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "&Beenden", IDM_GAME_EXIT
    END
    MENUITEM "Abräumen", IDM_GAME_FINISH, GRAYED
    POPUP "&?"
    BEGIN
        MENUITEM "&Inhalt\tF1", IDM_HELP_CONTENTS
        MENUITEM "Inf&o", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END
