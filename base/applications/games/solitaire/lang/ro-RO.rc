/* Strings */

STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitaire"
    IDS_SOL_ABOUT "Solitaire de J Brown; Tradus de Petru Dimitriu\nCardLib versiunea 1.0"
    IDS_SOL_QUIT "Abandonați jocul curent?"
    IDS_SOL_WIN "Felicitări, ați câștigat!"
    IDS_SOL_DEAL "Joc nou?"
    IDS_SOL_SCORE "Scor: %d"
    IDS_SOL_TIME "Timp: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Nu s-a găsit nicio mutare directă."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Joc"
    BEGIN
        MENUITEM "&Start\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Anulare\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "Indiciu\tF3", IDM_GAME_HINT
        MENUITEM "&Pachet cărţi…", IDM_GAME_DECK
        MENUITEM "&Opţiuni…", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "Cele mai bune scoruri...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "I&eşire", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Adună cărțile", IDM_GAME_FINISH, GRAYED
    POPUP "Aj&utor"
    BEGIN
        MENUITEM "&Cuprins\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Despre", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Cele mai bune scoruri"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Nume:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Salvare și împărțire din nou", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Salvare și ieșire", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Nume"
    IDS_HOF_PLACEMENT "#%lu — %ld Scor"
END
