STRINGTABLE
BEGIN
    IDS_SOL_NAME "Solitaire"
    IDS_SOL_ABOUT "Solitaire, J Brown tarafından yazılmıştır.\nCardLib sürümü: 1.0"
    IDS_SOL_QUIT "Şimdiki oyundan çıkılsın mı?"
    IDS_SOL_WIN "Tebrikler, kazandınız!"
    IDS_SOL_DEAL "Yeniden dağıtılsın mı?"
    IDS_SOL_SCORE "Skor: %d"
    IDS_SOL_TIME "Süre: %d"
    // TRANSLATORS: Machine translation; please review this new text.
    IDS_SOL_NO_HINT "Doğrudan bir hamle bulunamadı."
END

/* Menus */

IDR_MENU1 MENU
BEGIN
    POPUP "&Oyun"
    BEGIN
        MENUITEM "&Dağıt\tF2", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Geri al\tCtrl+Z", IDM_GAME_UNDO, GRAYED
    // TRANSLATORS: Machine translation; please review this new text.
        MENUITEM "İpucu\tF3", IDM_GAME_HINT
        MENUITEM "D&esteler...", IDM_GAME_DECK
        MENUITEM "&Seçenekler...", IDM_GAME_OPTIONS
        // TRANSLATORS: Machine translation; please review.
        MENUITEM "En iyi skorlar...", IDM_GAME_HIGHSCORES
        MENUITEM SEPARATOR
        MENUITEM "Ç&ıkış", IDM_GAME_EXIT
    END
    // TRANSLATORS: Machine translation; please review this new text.
    MENUITEM "Kartları topla", IDM_GAME_FINISH, GRAYED
    POPUP "&Yardım"
    BEGIN
        MENUITEM "&İçindekiler\tF1", IDM_HELP_CONTENTS
        MENUITEM "&Hakkında", IDM_HELP_ABOUT
    END
END

/* Accelerators */

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_GAME_NEW, VIRTKEY, NOINVERT
    "Z", IDM_GAME_UNDO, VIRTKEY, CONTROL, NOINVERT
    VK_F3, IDM_GAME_HINT, VIRTKEY, NOINVERT
END

// TRANSLATORS: Please review the player-name dialog and strings.
IDD_SCORENAME DIALOGEX 0, 0, 350, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "En iyi skorlar"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_HOF_PLACEMENT, 10, 10, 330, 14
    LTEXT "Ad:", -1, 10, 33, 60, 12
    EDITTEXT IDC_HOF_NAME, 75, 30, 265, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Kaydet ve yeniden dağıt", IDOK, 10, 65, 160, 28
    PUSHBUTTON "Kaydet ve çık", IDCANCEL, 180, 65, 160, 28
END

STRINGTABLE
BEGIN
    IDS_HOF_NAME "Ad"
    IDS_HOF_PLACEMENT "#%lu — %ld Skor"
END
