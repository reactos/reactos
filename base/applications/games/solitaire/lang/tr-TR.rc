LANGUAGE LANG_TURKISH, SUBLANG_DEFAULT

/* Dialogs */

IDD_OPTIONS DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Seçenekler"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Kağıtlar", -1, 7, 7, 135, 40
    AUTORADIOBUTTON "&Tekli Çek", IDC_OPT_DRAWONE, 14, 19, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Üçlü Çek", IDC_OPT_DRAWTHREE, 14, 32, 120, 10
    GROUPBOX "Skorlama", -1, 150, 7, 143, 53
    AUTORADIOBUTTON "&Standart", IDC_OPT_STANDARD, 157, 19, 126, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Vegas", IDC_OPT_VEGAS, 157, 32, 126, 10
    AUTORADIOBUTTON "&Yok", IDC_OPT_NOSCORE, 157, 45, 126, 10
    AUTOCHECKBOX "Sü&reyi Göster", IDC_OPT_SHOWTIME, 7, 51, 135,10, WS_TABSTOP
    AUTOCHECKBOX "&Durum Çubuğu", IDC_OPT_STATUSBAR, 7, 66, 135, 10, WS_TABSTOP
    AUTOCHECKBOX "S&koru Koru", IDC_OPT_KEEPSCORE, 150, 66, 143, 10, WS_TABSTOP
    // TRANSLATORS: Machine translation; please review this new text.
    LTEXT "Geri alma adımları (0 = kapalı):", -1, 7, 83, 225, 24
    EDITTEXT IDC_OPT_UNDO_LIMIT, 250, 84, 37, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_OPT_UNDO_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 274, 84, 13, 14
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Zafer animasyonu...", IDC_OPT_ANIMATION, 7, 110, 286, 18, WS_TABSTOP
    DEFPUSHBUTTON "Tamam", IDOK, 82, 139, 60, 14
    PUSHBUTTON "İptal", IDCANCEL, 158, 139, 60, 14
END

// TRANSLATORS: The following dialog is machine-translated; please review all new text.
IDD_ANIMATION DIALOGEX 0, 0, 260, 202
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Zafer animasyonu"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "Pencerede (klasik)", IDC_ANIM_WINDOW, 10, 10, 240, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Bu monitörde", IDC_ANIM_MONITOR, 10, 27, 240, 12
    AUTORADIOBUTTON "Tüm monitörlerde", IDC_ANIM_DESKTOP, 10, 44, 240, 12
    GROUPBOX "Hız", -1, 7, 64, 246, 82
    CONTROL "", IDC_ANIM_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 14, 78, 232, 24
    LTEXT "50 %", -1, 16, 103, 35, 10
    CTEXT "100 %", IDC_ANIM_VALUE, 103, 103, 54, 10
    RTEXT "200 %", -1, 209, 103, 35, 10
    PUSHBUTTON "Varsayılan: 100 %", IDC_ANIM_DEFAULT, 55, 119, 150, 18
    // TRANSLATORS: Machine translation; please review this new text.
    PUSHBUTTON "Önizleme (5 saniye)", IDC_ANIM_PREVIEW, 55, 153, 150, 18
    DEFPUSHBUTTON "Tamam", IDOK, 72, 181, 54, 14
    PUSHBUTTON "İptal", IDCANCEL, 134, 181, 54, 14
END

IDD_CARDBACK DIALOGEX 6, 6, 345, 185
CAPTION "Kağıt Sırtını Seç"
FONT 8, "MS Shell Dlg"
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
BEGIN
    CONTROL "", IDC_CARDBACK1, "Static", SS_NOTIFY, 4, 7, 50, 71
    CONTROL "", IDC_CARDBACK2, "Static", SS_NOTIFY, 61, 7, 50, 71
    CONTROL "", IDC_CARDBACK3, "Static", SS_NOTIFY, 118, 7, 50, 71
    CONTROL "", IDC_CARDBACK4, "Static", SS_NOTIFY, 175, 7, 50, 71
    CONTROL "", IDC_CARDBACK5, "Static", SS_NOTIFY, 232, 7, 50, 71
    CONTROL "", IDC_CARDBACK6, "Static", SS_NOTIFY, 289, 7, 50, 71
    CONTROL "", IDC_CARDBACK7, "Static", SS_NOTIFY, 4, 89, 50, 71
    CONTROL "", IDC_CARDBACK8, "Static", SS_NOTIFY, 61, 89, 50, 71
    CONTROL "", IDC_CARDBACK9, "Static", SS_NOTIFY, 118, 89, 50, 71
    CONTROL "", IDC_CARDBACK10, "Static", SS_NOTIFY, 175, 89, 50, 71
    CONTROL "", IDC_CARDBACK11, "Static", SS_NOTIFY, 232, 89, 50, 71
    CONTROL "", IDC_CARDBACK12, "Static", SS_NOTIFY, 289, 89, 50, 71
    DEFPUSHBUTTON "Tamam", IDOK, 114, 165, 54, 14
    PUSHBUTTON "İptal", IDCANCEL, 176, 165, 54, 14
END

/* Strings */

// TRANSLATORS: Machine translation; please review this new high-score dialog and its strings.
IDD_HIGHSCORES DIALOGEX 0, 0, 420, 291
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "En iyi skorlar"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Skorlama", -1, 7, 10, 54, 12
    COMBOBOX IDC_HOF_MODE, 64, 7, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Süreli oyunlar", IDC_HOF_TIMED, 218, 10, 195, 12, WS_TABSTOP
    LTEXT "Kağıtlar", -1, 7, 32, 54, 12
    COMBOBOX IDC_HOF_DRAW, 64, 29, 145, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_HOF_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 54, 406, 168
    LTEXT "Standart: kazanılan oyunlar. Vegas: toplam bakiyeden ayrı puanlanan bitmiş turlar. Her kategorideki en iyi on sonuç.", -1, 7, 230, 406, 32
    DEFPUSHBUTTON "Tamam", IDOK, 180, 270, 60, 14
END

