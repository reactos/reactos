LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_CHARMAP DIALOGEX 6, 6, 290, 224
FONT 9, "MS UI Gothic"
STYLE WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_SIZEBOX
CAPTION "ReactOS 文字コード表"
BEGIN
    LTEXT "フォント(&F):", IDC_STATIC, 6, 7, 24, 9
    COMBOBOX IDC_FONTCOMBO, 28, 5, 150, 210, WS_CHILD | WS_VISIBLE |
            WS_VSCROLL | CBS_DROPDOWNLIST | CBS_SORT | CBS_HASSTRINGS
    LTEXT "コピーする文字(&C):", IDC_STATIC, 6, 188, 66, 9
    CONTROL "", IDC_TEXTBOX, RICHEDIT_CLASS, ES_AUTOHSCROLL | WS_BORDER |
            WS_CHILD | WS_VISIBLE | WS_TABSTOP, 74, 186, 114, 13
    DEFPUSHBUTTON "選択(&S)", IDC_SELECT, 194, 186, 44, 13
    PUSHBUTTON "コピー(&P)", IDC_COPY, 242, 186, 44, 13, WS_DISABLED
END

STRINGTABLE
BEGIN
    IDS_ABOUT "バージョン情報(&A)..."
    IDS_TITLE "文字コード表"
END
