LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

STRINGTABLE
BEGIN
    IDS_PROPERTIES_MAIN_TITLE "(%c:) 磁碟清理"
    IDS_TOTAL_CLEANABLE_CAPTION "您可以使用 磁碟清理，將最多 %s 的磁碟空間從磁碟 (%c:) 中釋放。"
    IDS_DISK_CLEANUP "磁碟清理"
    IDS_CONFIRM_DELETE "您確定要永久刪除這些檔案？"
    IDS_CALCULATING "磁碟清理正在計算可以在 (%s) 上釋放的空間。"
    IDS_SCANNING "正在掃描：%s"
    IDS_CLEANING_CAPTION "磁碟清理正在清理 %s 的檔案。"
    IDS_CLEANING "正在清理：%s"
END

IDD_PROPERTIES_MAIN DIALOGEX 0, 0, 235, 215
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "磁碟清理"
FONT 9, "新細明體", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_DISKICON,"Static",SS_ICON,6,6,20,20
    LTEXT           "您可以使用 磁碟清理，將最多 0.0MB 的磁碟空間從磁碟 C: 中釋放。",IDC_TOTAL_CLEANABLE,36,6,192,18
    LTEXT           "要刪除的檔案：",IDC_STATIC,6,30,222,8
    CONTROL         "",IDC_HANDLERLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,6,42,222,66
    LTEXT           "可取得的磁碟空間總數：",IDC_STATIC,6,114,144,8
    RTEXT           "",IDC_SELECTED_GAINED,156,114,73,8
    GROUPBOX        "描述",IDC_STATIC,6,126,222,84
    LTEXT           "",IDC_DESCRIPTION,12,138,210,54
    PUSHBUTTON      "詳細資料...",IDC_DETAILS,150,192,74,14
END

IDD_SELECTDRIVE DIALOGEX 0, 0, 177, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "磁碟清理 - 選擇磁碟"
FONT 9, "新細明體", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,30,48,50,14
    PUSHBUTTON      "結束(&X)",IDCANCEL,96,48,50,14
    LTEXT           "選擇要清理的磁碟。",IDC_STATIC,12,6,150,8
    COMBOBOX        IDC_DRIVES,12,24,150,90,CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END
