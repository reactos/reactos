LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_PROPERTIES_MAIN_TITLE "(%c:) のディスク クリーンアップ"
    IDS_TOTAL_CLEANABLE_CAPTION "ドライブ (%c:) では、ディスク クリーンアップを使用して最大 %s のディスク領域を解放できます。"
    IDS_DISK_CLEANUP "ディスク クリーンアップ"
    IDS_CONFIRM_DELETE "これらのファイルを完全に削除してもよろしいですか？"
    IDS_CALCULATING "ディスク クリーンアップで (%s) の解放可能なディスク領域を計算しています。"
    IDS_SCANNING "スキャン中: %s"
    IDS_CLEANING_CAPTION "%s のファイルをクリーンアップしています。"
    IDS_CLEANING "クリーンアップ中: %s"
END

IDD_PROPERTIES_MAIN DIALOGEX 0, 0, 235, 215
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "ディスク クリーンアップ"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    CONTROL         "", IDC_DISKICON, "Static", SS_ICON, 6, 6, 20, 20
    LTEXT           "ディスク クリーンアップを使用すると、ドライブ C: のディスク領域を最大 0.0 MB 解放できます。", IDC_TOTAL_CLEANABLE, 36, 6, 192, 18
    LTEXT           "削除するファイル:", IDC_STATIC, 6, 30, 222, 8
    CONTROL         "", IDC_HANDLERLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 6, 42, 222, 66
    LTEXT           "解放されるディスク領域:", IDC_STATIC, 6, 114, 144, 8
    RTEXT           "", IDC_SELECTED_GAINED, 156, 114, 73, 8
    GROUPBOX        "説明", IDC_STATIC, 6, 126, 222, 84
    LTEXT           "", IDC_DESCRIPTION, 12, 138, 210, 54
    PUSHBUTTON      "詳細(&D)...", IDC_DETAILS, 150, 192, 74, 14
END

IDD_SELECTDRIVE DIALOGEX 0, 0, 177, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ディスク クリーンアップ - ドライブの選択"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 30, 48, 50, 14
    PUSHBUTTON      "キャンセル", IDCANCEL, 96, 48, 50, 14
    LTEXT           "クリーンアップするドライブを選択してください。", IDC_STATIC, 12, 6, 150, 8
    COMBOBOX        IDC_DRIVES, 12, 24, 150, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END
