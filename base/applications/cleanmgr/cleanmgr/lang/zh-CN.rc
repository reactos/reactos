LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_PROPERTIES_MAIN_TITLE "(%c:) 磁盘清理"
    IDS_TOTAL_CLEANABLE_CAPTION "您可以使用 磁盘清理，将最多 %s 的磁盘空间从磁盘 (%c:) 中释放。"
    IDS_DISK_CLEANUP "磁盘清理"
    IDS_CONFIRM_DELETE "您确定要永久删除这些文件？"
    IDS_CALCULATING "磁盘清理正在计算可以在 (%s) 上释放的空间。"
    IDS_SCANNING "正在扫描：%s"
    IDS_CLEANING_CAPTION "磁盘清理正在清理 %s 的文件。"
    IDS_CLEANING "正在清理：%s"
END

IDD_PROPERTIES_MAIN DIALOGEX 0, 0, 235, 215
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "磁盘清理"
FONT 9, "宋体", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_DISKICON,"Static",SS_ICON,6,6,20,20
    LTEXT           "您可以使用 磁盘清理，将最多 0.0MB 的磁盘空间从磁盘 C: 中释放。",IDC_TOTAL_CLEANABLE,36,6,192,18
    LTEXT           "要删除的文件：",IDC_STATIC,6,30,222,8
    CONTROL         "",IDC_HANDLERLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,6,42,222,66
    LTEXT           "释放的磁盘空间总数：",IDC_STATIC,6,114,144,8
    RTEXT           "",IDC_SELECTED_GAINED,156,114,73,8
    GROUPBOX        "描述",IDC_STATIC,6,126,222,84
    LTEXT           "",IDC_DESCRIPTION,12,138,210,54
    PUSHBUTTON      "详细资料...",IDC_DETAILS,150,192,74,14
END

IDD_SELECTDRIVE DIALOGEX 0, 0, 177, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "磁盘清理 - 选择磁盘"
FONT 9, "宋体", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,30,48,50,14
    PUSHBUTTON      "结束(&X)",IDCANCEL,96,48,50,14
    LTEXT           "选择要清理的磁盘。",IDC_STATIC,12,6,150,8
    COMBOBOX        IDC_DRIVES,12,24,150,90,CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END
