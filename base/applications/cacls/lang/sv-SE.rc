/*
 * PROJECT:    ReactOS CACLS
 * FILE:       base/applications/cacls/lang/sv-SE.rc
 * PURPOSE:    Swedish resource file
 * TRANSLATOR: Jaix Bly
 */

LANGUAGE LANG_SWEDISH, SUBLANG_NEUTRAL

STRINGTABLE
BEGIN
    IDS_HELP "Visar eller ändrar åtkomstkontrollistor (ACL) för filer\n\n\
CACLS filnamn  [/T] [/E] [/C] [/G användare:rättighet [...]] [/R användare [...]]\n\
               [/P användare:rättighet [...]] [/D användare [...]]\n\
   filnamn       Visar ACL:er.\n\
   /T            Ändrar ACL:er för angivna filer i\n\
                 den aktuella katalogen och alla underkataloger.\n\
   /E            Redigerar ACL i stället för att ersätta den.\n\
   /C            Fortsätter vid fel med nekad åtkomst.\n\
   /G användare:rättighet  Beviljar den angivna användaren åtkomsträttigheter.\n\
                 rättighet kan vara: L  Läs\n\
                              S  Skriv\n\
                              E  Ändra (skriv)\n\
                              F  Full kontroll\n\
  /R användare      Återkallar den angivna användarens åtkomsträttigheter (endast giltigt med /E).\n\
  /P användare:rättighet Ersätter den angivna användarens åtkomsträttigheter.\n\
                 rättighet kan vara: I  Ingen\n\
                               L  Läs\n\
                               S  Skriv\n\
                               E  Ändra (skriv)\n\
                               F  Full kontroll\n\
   /D användare     Nekar den angivna användaren åtkomst.\n\
Jokertecken kan användas för att ange fler än en fil i ett kommando.\n\
Du kan ange fler än en användare i ett kommando.\n\n\
Förkortningar:\n\
   CI - Behållarärvning.\n\
        ACE ärvs av kataloger.\n\
   OI - Objektärvning.\n\
        ACE ärvs av filer.\n\
   IO - Endast ärvning.\n\
        ACE gäller inte för den aktuella filen eller katalogen.\n"
    IDS_ABBR_CI "(CI)"
    IDS_ABBR_OI "(OI)"
    IDS_ABBR_IO "(IO)"
    IDS_ABBR_FULL "F"
    IDS_ABBR_READ "R"
    IDS_ABBR_WRITE "W"
    IDS_ABBR_CHANGE "C"
    IDS_ABBR_NONE "N"
    IDS_ALLOW ""
    IDS_DENY "(NEKA)"
    IDS_SPECIAL_ACCESS "(särskild åtkomst:)"
    IDS_GENERIC_READ "GENERIC_READ"
    IDS_GENERIC_WRITE "GENERIC_WRITE"
    IDS_GENERIC_EXECUTE "GENERIC_EXECUTE"
    IDS_GENERIC_ALL "GENERIC_ALL"
    IDS_FILE_GENERIC_EXECUTE "FILE_GENERIC_EXECUTE"
    IDS_FILE_GENERIC_READ "FILE_GENERIC_READ"
    IDS_FILE_GENERIC_WRITE "FILE_GENERIC_WRITE"
    IDS_FILE_READ_DATA "FILE_READ_DATA"
    IDS_FILE_WRITE_DATA "FILE_WRITE_DATA"
    IDS_FILE_APPEND_DATA "FILE_APPEND_DATA"
    IDS_FILE_READ_EA "FILE_READ_EA"
    IDS_FILE_WRITE_EA "FILE_WRITE_EA"
    IDS_FILE_EXECUTE "FILE_EXECUTE"
    IDS_FILE_DELETE_CHILD "FILE_DELETE_CHILD"
    IDS_FILE_READ_ATTRIBUTES "FILE_READ_ATTRIBUTES"
    IDS_FILE_WRITE_ATTRIBUTES "FILE_WRITE_ATTRIBUTES"
    IDS_MAXIMUM_ALLOWED "MAXIMUM_ALLOWED"
    IDS_ACCESS_SYSTEM_SECURITY "ACCESS_SYSTEM_SECURITY"
    IDS_SPECIFIC_RIGHTS_ALL "SPECIFIC_RIGHTS_ALL"
    IDS_STANDARD_RIGHTS_REQUIRED "STANDARD_RIGHTS_REQUIRED"
    IDS_SYNCHRONIZE "SYNCHRONIZE"
    IDS_WRITE_OWNER "WRITE_OWNER"
    IDS_WRITE_DAC "WRITE_DAC"
    IDS_READ_CONTROL "READ_CONTROL"
    IDS_DELETE "DELETE"
    IDS_STANDARD_RIGHTS_ALL "STANDARD_RIGHTS_ALL"
END
