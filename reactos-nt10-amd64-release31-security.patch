+    _SEH2_TRY
+    {
+        RtlCopyMemory(Destination, Source, Length);
+    }
+    _SEH2_FINALLY
+    {
+        if (SmapActive)
+            __asm__ __volatile__(".byte 0x0f, 0x01, 0xca" ::: "memory"); /* CLAC */
+    }
+    _SEH2_END;
+}
+#else
+#define MiSmapCopyMemory(Destination, Source, Length) \\
+    RtlCopyMemory((Destination), (Source), (Length))
+#endif
