STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&الإجراء:", -1, 5, 7, 150, 10
    EDITTEXT IDC_ACTION_ACTION, 5, 20, 150, 14, ES_AUTOHSCROLL
    LTEXT "&التطبيق المستخدم لتنفيذ الإجراء:", -1, 5, 42, 150, 10
    EDITTEXT IDC_ACTION_APP, 5, 55, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON "اس&تعرض...", IDC_ACTION_BROWSE, 160, 60, 60, 14
    AUTOCHECKBOX "استخدام &DDE", IDC_ACTION_USE_DDE, 10, 75, 103, 14
    DEFPUSHBUTTON "موافق", IDOK, 160, 20, 60, 14
    PUSHBUTTON "إلغاء", IDCANCEL, 160, 40, 60, 14
END

IDD_FOLDER_CUSTOMIZE DIALOGEX 0, 0, 240, 220
CAPTION "تخصيص"
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "أي نوع من المجلدات تريد؟", IDC_STATIC, 5, 5, 230, 65, WS_TABSTOP
    LTEXT "استخدم &نوع المجلد هذا كقالب:", IDC_STATIC, 15, 20, 210, 12
    COMBOBOX IDC_FOLDERCUST_COMBOBOX, 15, 35, 210, 300, CBS_HASSTRINGS | CBS_AUTOHSCROLL | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "تطبيق هذا القالب أيضاً على جميع &المجلدات الفرعية", IDC_FOLDERCUST_CHECKBOX, 15, 50, 210, 15
    GROUPBOX "صور المجلدات", IDC_STATIC, 5, 75, 230, 85, WS_TABSTOP
    LTEXT "في عرض الصور المصغرة, يمكنك وضع صورة على هذا المجلد لتذكيرك بالمحتويات.", IDC_STATIC, 15, 87, 115, 33
    PUSHBUTTON "اختيار &صورة...", IDC_FOLDERCUST_CHOOSE_PIC, 15, 120, 115, 15
    PUSHBUTTON "&استعادة الافتراضي", IDC_FOLDERCUST_RESTORE_DEFAULTS, 15, 139, 115, 15
    LTEXT "معاينة:", IDC_STATIC, 139, 85, 81, 11
    CONTROL "", IDC_FOLDERCUST_PREVIEW_BITMAP, "STATIC", SS_BITMAP | WS_GROUP, 150, 100, 60, 60
    GROUPBOX "أيقونات المجلدات", IDC_STATIC, 5, 165, 230, 50, WS_TABSTOP
    LTEXT "بالنسبة لجميع العروض باستثناء الصور المصغرة, يمكنك تغيير الأيقونة القياسية ""مجلد"" إلى أيقونة أخرى.", IDC_STATIC, 15, 175, 210, 25
    ICON 0, IDC_FOLDERCUST_ICON, 175, 194, 32, 30
    PUSHBUTTON "تغيير &أيقونة...", IDC_FOLDERCUST_CHANGE_ICON, 15, 195, 75, 15
END

IDD_LINK_PROBLEM DIALOGEX 0, 0, 250, 140
CAPTION "Problem with Shortcut"
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
    ICON 0, IDC_LINK_PROBLEM_ICON, 5, 5, 0, 0
    LTEXT "The item '%s' that this shortcut refers to has been changed or moved, so this shortcut will no longer work properly.", IDC_LINK_PROBLEM_LABEL1, 35, 5, 210, 35
    LTEXT "Nearest match based on name, type, size, and date:", IDC_LINK_PROBLEM_LABEL2, 35, 45, 210, 35
    LTEXT "Do you want to fix this shortcut to point to this target or do you just want to delete it?", -1, 35, 85, 210, 30
    DEFPUSHBUTTON "&Fix it", IDOK, 55, 120, 60, 15, WS_DISABLED
    PUSHBUTTON "&Delete it", IDYES, 120, 120, 60, 15
    PUSHBUTTON "إلغاء", IDCANCEL, 185, 120, 60, 15
END

