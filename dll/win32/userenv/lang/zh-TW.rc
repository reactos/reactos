/* ATTENTION: If there is no special situation, please DO NOT change
English folder names into Chinese, or it may cause problems in the system. */

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

IDD_ERRORDLG DIALOGEX 0, 0, 250, 95
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "使用者設定檔"
FONT 9, "新細明體"
BEGIN
    ICON IDI_USERENV, IDC_STATIC, 6, 10, 18, 20
    DEFPUSHBUTTON "確定", IDOK, 190, 10, 50, 14, BS_NOTIFY | WS_TABSTOP
    EDITTEXT IDC_ERRORDESC, 37, 10, 145, 66, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    RTEXT "剩餘時間︰", IDC_TIMEOUTSTATIC, 172, 80, 54, 8
    LTEXT "", IDC_TIMEOUT, 230, 80, 12, 8
END
