LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_INSTALL DIALOG 0, 0, 205, 60
CAPTION "正在安装字体..."
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "宋体"
BEGIN
    LTEXT "正在安装字体...", IDC_INSTALL_TEXT, 5, 10, 195, 10
    CONTROL "", IDC_INSTALL_PROGRESS, "msctls_progress32", 0, 5, 25, 195, 10
    PUSHBUTTON "取消", IDCANCEL, 65, 40, 70, 15
END

STRINGTABLE
BEGIN
    IDS_REACTOS_FONTS_FOLDER "ReactOS 字体文件夹"
    IDS_INSTALL_OK "字体安装成功。"
    IDS_INSTALL_FAILED "字体安装失败。"
    IDS_CONFIRM_DELETE_FONT "要删除所选字体吗？"
    IDS_PROPERTIES "属性(&R)"
    IDS_CANTDELETEFONT "无法删除所选字体。"
END

STRINGTABLE
BEGIN
    IDS_COL_NAME "名称"
END

STRINGTABLE
BEGIN
    IDS_COL_FILENAME "文件名"
    IDS_COL_SIZE "大小"
    IDS_COL_MODIFIED "修改日期"
    IDS_COL_ATTR "属性"
END

STRINGTABLE
BEGIN
    IDS_FONT_PREVIEW "预览"
END
