;
; ReactOS reduced legacy VirtIO-blk Storport miniport installation
; Supports PCI\VEN_1AF4&DEV_1001 only; modern capability devices are rejected.
;
[Version]
Signature="$Windows NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ReactOS%
DriverVer=08/10/2026,1.0

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
viostor.sys=1

[DestinationDirs]
VioStor_CopyFiles=12

[Manufacturer]
%ReactOS%=VioStor

[VioStor]
%VIOSTOR.DeviceDesc%=VioStor_Install,PCI\VEN_1AF4&DEV_1001

[VioStor_Install]
CopyFiles=VioStor_CopyFiles

[VioStor_CopyFiles]
viostor.sys

[VioStor_Install.Services]
AddService=viostor,0x00000002,VioStor_Service

[VioStor_Service]
DisplayName=%VIOSTOR.DeviceDesc%
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%12%\viostor.sys
LoadOrderGroup=SCSI Miniport

[Strings]
ReactOS="ReactOS"
DiskName="VirtIO Block Device"
VIOSTOR.DeviceDesc="VirtIO Block Device"
